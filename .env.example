# Copy this file to .env and fill in real values.
# All variables are prefixed with PRIVEIL_ except provider API keys.

# ── LLM judge (optional) ─────────────────────────────────────────────────────
# Enables two things:
#   1. Span-verdict judge mode on POST /detect and POST /pseudonymise (mode='judge')
#   2. POST /assess — content risk and sensitivity assessment
#
# When unset: mode='judge' degrades silently to mode='fast'; /assess returns 503.
#
# IMPORTANT: The span-verdict refiner (/detect, /pseudonymise judge mode) uses a
# raw OpenAI-compatible client. Only OpenAI and OpenAI-compatible endpoints are
# supported for refinement. Non-OpenAI providers (anthropic:, google:) work for
# /assess only (via pydantic-ai), but the refiner will fail-open for those.
#
# OpenAI (refiner + assessor both work):
#   PRIVEIL_JUDGE_MODEL=openai:gpt-4o-mini
#   OPENAI_API_KEY=your-openai-api-key-here
#
# Anthropic (assessor only — refiner fails-open):
#   PRIVEIL_JUDGE_MODEL=anthropic:claude-haiku-3-5
#   ANTHROPIC_API_KEY=your-anthropic-api-key-here
#
# Custom OpenAI-compatible endpoint — vLLM, Ollama, Databricks, Azure AI, etc.
# (refiner + assessor both work):
#   PRIVEIL_JUDGE_MODEL=<deployment-or-model-name>   # raw name, no provider prefix
#   PRIVEIL_JUDGE_BASE_URL=http://localhost:11434/v1  # Ollama example
#   PRIVEIL_JUDGE_API_KEY=<api-key-or-token>          # optional; "local" used if unset
PRIVEIL_JUDGE_MODEL=openai:gpt-4o-mini
# PRIVEIL_JUDGE_BASE_URL=
# PRIVEIL_JUDGE_API_KEY=

# Sampling temperature for the judge (0.0 = deterministic).
PRIVEIL_JUDGE_TEMPERATURE=0.0

# Span-verdict judge tuning.
# PRIVEIL_JUDGE_SCORE_THRESHOLD: entities scoring >= this bypass the judge (certain PII).
# Presidio's NER-based recognisers (PERSON, LOCATION) default to 0.85; pattern-based
# recognisers (AU_TFN, EMAIL) emit 1.0. 0.9 sends 0.85-confidence NER detections to
# the judge while treating 1.0-confidence pattern matches as certain.
PRIVEIL_JUDGE_SCORE_THRESHOLD=0.9
PRIVEIL_JUDGE_CONTEXT_CHARS=60
PRIVEIL_JUDGE_TIMEOUT_MS=250
PRIVEIL_JUDGE_MAX_TOKENS=64

# ── Provider API keys ────────────────────────────────────────────────────────
# Required when PRIVEIL_JUDGE_MODEL uses the openai provider.
# OPENAI_API_KEY=your-openai-api-key-here

# Required when PRIVEIL_JUDGE_MODEL uses the anthropic provider (/assess only).
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── spaCy model ──────────────────────────────────────────────────────────────
# en_core_web_sm  — small, fast, used in CI and tests (default)
# en_core_web_lg  — larger, more accurate NER, recommended for production
# Download: uv run python -m spacy download en_core_web_lg
PRIVEIL_SPACY_MODEL=en_core_web_sm

# ── Server ───────────────────────────────────────────────────────────────────
PRIVEIL_DEBUG=false

# Thread-pool workers for presidio (CPU-bound). Rule of thumb: number of cores.
PRIVEIL_EXECUTOR_MAX_WORKERS=4
