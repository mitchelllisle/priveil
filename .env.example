# Copy this file to .env and fill in real values.
# All variables are prefixed with PRIVEIL_ except provider API keys.

# ── LLM advisor (optional) ────────────────────────────────────────────────────
# Enables two things:
#   1. Span-verdict advisor mode on POST /detect and POST /pseudonymise (mode='advisor')
#   2. POST /assess — content risk and sensitivity assessment
#
# When unset: mode='advisor' degrades silently to mode='fast'; /assess returns 503.
#
# Both span advising and assessment use pydantic-ai, so all supported providers work
# (openai:, anthropic:, google:, and OpenAI-compatible custom endpoints).
#
# OpenAI:
#   PRIVEIL_ADVISOR_MODEL=openai:gpt-4o-mini
#   OPENAI_API_KEY=your-openai-api-key-here
#
# Anthropic:
#   PRIVEIL_ADVISOR_MODEL=anthropic:claude-haiku-3-5
#   ANTHROPIC_API_KEY=your-anthropic-api-key-here
#
# Custom OpenAI-compatible endpoint — vLLM, Ollama, Databricks, Azure AI, etc.
# (advisor + assessor both work):
#   PRIVEIL_ADVISOR_MODEL=<deployment-or-model-name>   # raw name, no provider prefix
#   PRIVEIL_ADVISOR_BASE_URL=http://localhost:11434/v1  # Ollama example
#   PRIVEIL_ADVISOR_API_KEY=<api-key-or-token>          # optional; "local" used if unset
#
# Local Ollama (Gemma 4):
#   PRIVEIL_ADVISOR_MODEL=gemma4:e4b
#   PRIVEIL_ADVISOR_BASE_URL=http://localhost:11434/v1
#
# Production vLLM (Gemma 4):
#   PRIVEIL_ADVISOR_MODEL=google/gemma-4-E4B-it
#   PRIVEIL_ADVISOR_BASE_URL=http://vllm:8000/v1
PRIVEIL_ADVISOR_MODEL=openai:gpt-4o-mini
# PRIVEIL_ADVISOR_BASE_URL=
# PRIVEIL_ADVISOR_API_KEY=

# Sampling temperature for the advisor (0.0 = deterministic).
PRIVEIL_ADVISOR_TEMPERATURE=0.0

# Span-verdict advisor tuning.
# PRIVEIL_ADVISOR_SCORE_THRESHOLD: entities scoring >= this bypass all verification (certain PII).
# Presidio's NER-based recognisers (PERSON, LOCATION) default to 0.85; pattern-based
# recognisers (AU_TFN, EMAIL) emit 1.0. 0.9 sends 0.85-confidence NER detections to
# the advisor while treating 1.0-confidence pattern matches as certain.
PRIVEIL_ADVISOR_SCORE_THRESHOLD=0.9
PRIVEIL_ADVISOR_CONTEXT_CHARS=60
PRIVEIL_ADVISOR_TIMEOUT_MS=250
PRIVEIL_ADVISOR_MAX_TOKENS=64

# ── Provider API keys ────────────────────────────────────────────────────────
# Required when PRIVEIL_ADVISOR_MODEL uses the openai provider.
# OPENAI_API_KEY=your-openai-api-key-here

# Required when PRIVEIL_ADVISOR_MODEL uses the anthropic provider (/assess only).
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Server ───────────────────────────────────────────────────────────────────
PRIVEIL_DEBUG=false

# Thread-pool workers for presidio (CPU-bound). Rule of thumb: number of cores.
PRIVEIL_EXECUTOR_MAX_WORKERS=4
